<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service resolves its notification icons by name at runtime
     (Resources.getIdentifier), which the release resource shrinker can't
     see — without this keep rule they get stripped and every playback
     state update throws "You must specify an icon resource id".

     That covers audio_service's own drawables *and* the ones this app
     hands it by name from main.dart / audio_handler.dart: nothing in Java,
     Kotlin or XML references them, so the shrinker drops them from release
     builds even though debug builds are fine. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_notification_close,@drawable/ic_stat_electrowave" />
